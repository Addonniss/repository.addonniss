msgctxt "#30052"
msgid "Enter the full LibreTranslate URL starting with http:// or https://. Example: http://your-server:5000 . Make sure your server loaded the needed languages, for example LT_LOAD_ONLY=en,ro. Batch limit also matters: set LT_BATCH_LIMIT above your selected chunk size. 1000 is a good setting."
msgstr ""

msgctxt "#30053"
msgid "LibreTranslate API Key"
msgstr ""

msgctxt "#30054"
msgid "Optional. Leave empty if your self-hosted LibreTranslate server does not require an API key."
msgstr ""

msgctxt "#30055"
msgid "Source Language (LibreTranslate Server)"
msgstr ""

msgctxt "#30056"
msgid "Select a source language that exists on your LibreTranslate server. Match this with the languages loaded on the server, for example LT_LOAD_ONLY=en,ro."
msgstr ""

msgctxt "#30057"
msgid "Target Language (LibreTranslate Server)"
msgstr ""

msgctxt "#30058"
msgid "Select a target language that exists on your LibreTranslate server. Match this with the languages loaded on the server, for example LT_LOAD_ONLY=en,ro."
msgstr ""

msgctxt "#30059"
msgid "SDH/HI cue removal"
msgstr ""

msgctxt "#30060"
msgid "Removes common hearing-impaired subtitle cues such as sound effects, music markers, and speaker labels when they are not spoken dialogue. Tries to preserve actual dialogue."
msgstr ""

msgctxt "#30061"
msgid "Dual-Language Display"
msgstr ""

msgctxt "#30062"
msgid "When enabled, each subtitle entry shows the original source text on the first line and the translated text below it. When disabled, Translatarr keeps the current translated-only display."
msgstr ""

msgctxt "#30063"
msgid "Enable Local Extraction"
msgstr ""

msgctxt "#30064"
msgid "Enables local embedded subtitle extraction with MKVToolNix or FFmpeg when no usable subtitle is found during playback. If both local extraction and Remote Extractor are enabled, Translatarr tries local extraction first. In Auto mode, extracted source subtitles are written to the Translatarr subtitle folder. In Manual mode, they are written to your configured manual subtitle folder."
msgstr ""

msgctxt "#30065"
msgid "MKVToolNix Executables Folder"
msgstr ""

msgctxt "#30066"
msgid "Optional folder containing mkvinfo and mkvextract. Used for embedded subtitle detection and extraction from MKV files. Leave empty to use the system PATH."
msgstr ""

msgctxt "#30067"
msgid "FFmpeg Executables Folder"
msgstr ""

msgctxt "#30068"
msgid "Optional folder containing ffmpeg and ffprobe. Used for embedded subtitle detection and extraction from MP4 files, and for subtitle conversion when needed. Leave empty to use the system PATH."
msgstr ""

msgctxt "#30071"
msgid "Enable Translation Service"
msgstr ""

msgctxt "#30072"
msgid "Turns the Translatarr background service on or off without disabling the add-on in Kodi. When off, subtitle polling and translation stay paused until you enable it again."
msgstr ""

msgctxt "#30073"
msgid "Force Extraction"
msgstr ""

msgctxt "#30074"
msgid "Extract and translate from the source embedded subtitle even when a target-language embedded subtitle already exists. Applies to both Local and Remote extraction. Recommended when the embedded target subtitle is poor AI translation."
msgstr ""

msgctxt "#30075"
msgid "Embedded Subtitles"
msgstr ""

msgctxt "#30076"
msgid "Translatarr Remote Extractor"
msgstr ""

msgctxt "#30077"
msgid "Enable Translatarr Remote Extractor"
msgstr ""

msgctxt "#30078"
msgid "Allows Translatarr to call Translatarr Remote Extractor, the companion subtitle-extraction service for platforms where local embedded extraction is unavailable or not practical. If local extraction is also enabled, Translatarr tries local extraction first and uses the remote extractor as fallback."
msgstr ""

msgctxt "#30079"
msgid "Remote Extractor URL"
msgstr ""

msgctxt "#30080"
msgid "Base URL for Translatarr Remote Extractor, for example http://server:8097. Translatarr will call its /probe and /extract endpoints when remote embedded subtitle handling is needed."
msgstr ""

msgctxt "#30081"
msgid "Remote Extractor Token"
msgstr ""

msgctxt "#30082"
msgid "Optional bearer token for the remote extractor service. Leave empty if the service does not require authentication."
msgstr ""

msgctxt "#30083"
msgid "Remote Extractor Timeout"
msgstr ""

msgctxt "#30084"
msgid "Maximum number of seconds used for both waiting on the remote extractor response and the real remote probe/extraction commands on the server."
msgstr ""

msgctxt "#30085"
msgid "Needs Local or Remote Extractor"
msgstr ""

msgctxt "#30086"
msgid "Extraction Method"
msgstr ""

msgctxt "#30105"
msgid "Rolling Source Context"
msgstr ""

msgctxt "#30106"
msgid "Adds previous source subtitle lines as read-only context for AI translation. Helps the model understand pronouns, sentence fragments, tone, and references across chunk boundaries without translating the context lines."
msgstr ""

msgctxt "#30107"
msgid "Rolling Context Window"
msgstr ""

msgctxt "#30108"
msgid "Number of previous source subtitle lines to include as read-only translation context. Allowed range is 3 to 8 lines."
msgstr ""

msgctxt "#30109"
msgid "Thinking Level"
msgstr ""

msgctxt "#30110"
msgid "Controls how much the Gemini 3.x model reasons before translating. Minimal is fastest and cheapest; High gives deepest reasoning. Does not apply to Gemini 2.5 models."
msgstr ""

msgctxt "#30111"
msgid "Reasoning Effort"
msgstr ""

msgctxt "#30112"
msgid "Controls how much the GPT-5 model reasons before translating. Minimal uses no reasoning on GPT-5.4 nano and GPT-5.6 Luna, and minimal reasoning on GPT-5 mini; High gives deepest reasoning. Does not apply to GPT-4 models."
msgstr ""

