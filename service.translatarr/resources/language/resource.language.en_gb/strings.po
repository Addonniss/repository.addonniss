msgid "OpenRouter API Key"
msgstr ""

msgctxt "#30114"
msgid "Enter your OpenRouter API key from openrouter.ai/keys."
msgstr ""

msgctxt "#30115"
msgid "OpenRouter Model"
msgstr ""

msgctxt "#30116"
msgid "Enter any OpenRouter model ID, e.g., deepseek/deepseek-v4-flash:free"
msgstr ""

